# --- Server ---
PORT=
NODE_ENV=

MONGO_URI=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=

# --- CORS ---
# Use a comma-separated list of origins in production. "*" is fine for local dev.
CORS_ORIGIN=

# Refresh token cookie and server-side session lifetime
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=
REFRESH_COOKIE_NAME=

# Redis
REDIS_URL=
REDIS_GUI=

# Email (Nodemailer + Ethereal for local)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- AI (Google Gemini free tier) ---
# Paste your Gemini API key here directly. Never commit this file.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
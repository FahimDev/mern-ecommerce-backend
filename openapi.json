{
  "openapi": "3.0.3",
  "info": {
    "title": "MERN Batch 15 E-commerce Backend API",
    "version": "1.0.0",
    "description": "Backend-only e-commerce API. Validation, types, and OpenAPI are all derived from the same Zod schemas — see src/controllers/ and src/docs/ for the source of truth."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Express server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and system routes"
    },
    {
      "name": "Auth",
      "description": "Authentication and account routes"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by POST /api/auth/login (coming soon)."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ],
        "description": "Standard success envelope used by every successful response."
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "mern-ecommerce-backend"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "not-connected"
            ],
            "example": "connected"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-14T07:46:08.271Z"
          }
        },
        "required": [
          "service",
          "database",
          "timestamp"
        ],
        "description": "Snapshot of API and database state."
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              }
            },
            "required": [
              "user"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ],
        "description": "Standard success envelope used by every successful response."
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "66a3e9b2f1c2a4b5c6d7e8f9"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "example": "Fahim Ahmed"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "fahim@example.com"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "emailVerified": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-14T07:46:08.271Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-14T07:46:08.271Z"
          }
        },
        "required": [
          "_id",
          "name",
          "email",
          "role",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ],
        "description": "Public user object. Never includes the password hash."
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "customer",
          "admin",
          "vendor"
        ],
        "description": "Role assigned to the user account.",
        "example": "customer"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "success",
          "message"
        ],
        "description": "Standard error envelope returned by the central error middleware."
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "example": "Fahim Ahmed"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "fahim@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "secret123",
            "description": "Minimum 6 characters. Hashed with bcrypt before storage."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "description": "Payload for creating a new customer account."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check API and database health",
        "description": "Used by humans, load balancers, and deployment scripts. Returns the database readyState along with the API service name.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "default": {
                    "summary": "Healthy",
                    "value": {
                      "success": true,
                      "message": "API health check successful",
                      "data": {
                        "service": "mern-ecommerce-backend",
                        "database": "connected",
                        "timestamp": "2026-07-14T07:46:08.271Z"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a customer account",
        "description": "Creates a new user with the `customer` role. Email must be unique (DB-level unique index). Password is bcrypt-hashed before storage; the hash is never returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "examples": {
                "default": {
                  "summary": "Sample registration",
                  "value": {
                    "name": "Fahim Ahmed",
                    "email": "fahim@example.com",
                    "password": "secret123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                },
                "examples": {
                  "default": {
                    "summary": "Created user",
                    "value": {
                      "success": true,
                      "message": "User registered successfully",
                      "data": {
                        "user": {
                          "_id": "66a3e9b2f1c2a4b5c6d7e8f9",
                          "name": "Fahim Ahmed",
                          "email": "fahim@example.com",
                          "role": "customer",
                          "emailVerified": false,
                          "createdAt": "2026-07-14T07:46:08.271Z",
                          "updatedAt": "2026-07-14T07:46:08.271Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (bad name, email, or short password)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}